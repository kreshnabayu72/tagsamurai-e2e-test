# Copy to .env (git-ignored) and fill in, or export these in the CI runner.
# Names follow docs/e2e-conventions.md §5.

# Actor accounts (shared across suites): <APP>_<ROLE>_PASSWORD
GS_TC_PASSWORD=   # Total Control Client A (Global Settings). Suite Brand: totalControl_automated_qaTeam1@qwertysystem.net; suite Auth: totalControlGlobalSettings_automated_{namaCompany}@qwertysystem.net. Satu password hanya bila kedua akun berbagi password; bila tidak, tim FE menetapkan nama env terpisah.

# Global Settings > Master Reference > Brand: akun per role (password dikelola tim FE)
GS_TC2_PASSWORD=   # totalControlSecond_automated_qaTeam1@qwertysystem.net (Total Control Client A, admin kedua; fixture baru; bukan admin kedua Client Limit, lihat GS_LIMIT_TC2_PASSWORD)
