# Auth > Account Activation test passwords (must satisfy the password policy)
ACT_PASSWORD=          # valid password, e.g. 8-72 chars with upper, lower, digit, special
ACT_PASSWORD_ALT=      # second valid password, different from ACT_PASSWORD
ACT_PASSWORD_72=       # valid password exactly 72 characters
ACT_PASSWORD_SPECIAL=  # valid password using the special characters ! @ ? &

# Auth > Login with Password test passwords
LP_PASSWORD=                # password valid akun uji Login with Password (QaLogin#2026 di TC)
LP_PASSWORD_NEW=            # password baru hasil Reset Password, memenuhi Password Policy (NewPass#2026 di TC)
LP_PASSWORD_WRONG=          # password salah yang valid secara format (SalahPass#1 di TC)
LP_PASSWORD_WRONG_SPECIAL=  # password salah berisi karakter khusus (x'"<>&%$#@! di TC)
LP_PASSWORD_SPACED=         # password dengan spasi di awal dan akhir (" Spasi#2026 " di TC); di-set langsung oleh BE
AC_PRINCIPAL_PP_PASSWORD=   # principalSettingsPrivacyPolicy_automated_{namaCompany}@qwertysystem.net (Principal, Admin Console > Settings > Privacy Policy)

# Auth > MFA test passwords (must satisfy the password policy)
MFA_PASSWORD=               # password valid user uji MFA yang di-seed lewat API
MFA_PASSWORD_NEW=           # password baru hasil Reset Password user uji MFA (spec 037)
# Auth > MFA: akun Total Control per Client (totalControlGlobalSettings_automated_{namaCompany}@qwertysystem.net milik tiap Client); password dikelola tim FE
GS_CLIENTSUSP_TC_PASSWORD=   # Total Control Client uji Suspended (Auth > MFA spec 038)
GS_CLIENTEXP_TC_PASSWORD=   # Total Control Client uji Expired (Auth > MFA spec 038)
GS_PLANSTARTER_TC_PASSWORD=   # Total Control Client plan Starter (Auth > MFA spec 039)
GS_PLANGROWTH_TC_PASSWORD=   # Total Control Client plan Growth (Auth > MFA spec 039)
GS_PLANPRO_TC_PASSWORD=   # Total Control Client plan Professional (Auth > MFA spec 039)
GS_PLANENT_TC_PASSWORD=   # Total Control Client plan Enterprise (Auth > MFA spec 039)

# Global Settings > Role: akun uji per kombinasi access level (email ada di Prerequisites spec Role); password dikelola tim FE
GS_ROLE_MANAGE_READ_PASSWORD=   # manageUserAndRoleRead_automated_{namaCompany}@qwertysystem.net (Manage user and role: Read saja)
GS_ROLE_MANAGE_CRD_PASSWORD=   # manageUserAndRoleCreateDelete_automated_{namaCompany}@qwertysystem.net (Manage user and role: Create, Read, Delete tanpa Update)
GS_ROLE_MANAGE_CRUD_PASSWORD=   # manageUserAndRoleCrud_automated_{namaCompany}@qwertysystem.net (Manage user and role: C/R/U/D, tanpa access level)
GS_ROLE_MANAGETAG_READ_PASSWORD=   # manageTagRead_automated_{namaCompany}@qwertysystem.net (Manage TAG: Read saja)
GS_ROLE_TARGET_PASSWORD=   # password akun target/aktor Role uji (Pre-setup, email disediakan tim FE); dipakai spec 008, 084, 085, 091, 092; arti satu-nama-satu-akun menunggu keputusan R-18

# Auth > Session Management test passwords (must satisfy the password policy)
SES_PASSWORD=               # password valid user uji Session Management yang di-seed lewat API
SES_PASSWORD_NEW=           # password baru hasil Change/Reset Password user uji Session Management
FA_MGL_PASSWORD=           # manageGlobalLicenseFixedAsset_automated_{namaCompany} (dipakai spec Session Management)
AC_PRINCIPAL_PASSWORD=      # principalAdminConsole_automated_{namaCompany} (dipakai spec Session Management)

# Auth > Reset Password test passwords (must satisfy the password policy)
RST_PASSWORD=               # password aktif user uji Reset Password yang di-seed lewat API (QaReset!2026 di TC)
RST_PASSWORD_NEW=           # password baru hasil Reset Password, berbeda dari RST_PASSWORD (QaBaru!2027 di TC)
RST_PASSWORD_ALT=           # password valid kedua untuk Confirm Password berbeda (QaBaru!2028 di TC)
RST_PASSWORD_ALT2=          # password valid ketiga untuk submit tab kedua (QaBaru!2029 di TC)
RST_PASSWORD_REPLAY=        # password valid untuk uji replay token consumed (QaReplay!2028 di TC)
RST_PASSWORD_LOWER=          # RST_PASSWORD_NEW dalam huruf kecil semua (qabaru!2027 di TC-112), untuk uji login case-sensitive
RST_PASSWORD_WRONG=          # password salah yang memenuhi format dan berbeda dari password aktif (SalahSalah!1 di TC-110)

# Auth > Login with OTP
OTP_PASSWORD=               # password valid yang dipasang ke user uji Login with OTP saat seeding aktivasi lewat API, dan dipakai untuk Login with Password di TC-AUTH-OTP-68 dan TC-AUTH-OTP-108
OTP_TOTP_SECRET_IDLE=       # secret TOTP authenticator yang didaftarkan hook before untuk profil IDLE (spec 033/034)
OTP_TOTP_SECRET_NEWDEV=     # secret TOTP authenticator yang didaftarkan hook before untuk profil NEWDEV (spec 033/034)

# Global Settings > User: akun aktor dan password user dinamis (password dikelola tim FE)
GS_DEFAULT_PASSWORD=        # defaultUserGlobalSettings_automated_{namaCompany}@qwertysystem.net (Default User Client A, Total Control, MFA Enrolled; spec 012)
GS_DEFAULT_NEW_PASSWORD=    # Default User pada client baru yang hanya berisi Default User (spec 004; akun berbeda dari GS_DEFAULT_PASSWORD; disediakan tim FE)
GS_FULLCRUD_PASSWORD=       # manageUserFullCrud_automated_{namaCompany}@qwertysystem.net (Manage user and role, Full CRUD)
GS_BASIC_PASSWORD=          # basicGlobalSettings_automated_{namaCompany}@qwertysystem.net (Basic, Access GS tanpa tier dan role)
GS_NOFAMS_TC_PASSWORD=      # Total Control Client tanpa subscription Fixed Asset (User spec 065, TC-385); disediakan tim FE
GS_NOSUPPLY_TC_PASSWORD=    # Total Control Client tanpa subscription Supply Asset (User spec 155, TC-980); disediakan tim FE
AC_STAFF_PASSWORD=          # staff Principal Admin Console (Rizal Akbar) untuk aksi Assign Role (User spec 147); disediakan tim FE
USER_PASSWORD=              # password valid (memenuhi password policy) yang dipasang ke user dinamis milik spec Global Settings > User lewat seeding API
USER_PASSWORD_NEW=          # password baru valid untuk event Change Password user dinamis (User spec 102-107)
USER_PASSWORD_WRONG=        # password salah yang valid secara format, dipakai untuk Login Failed dan lock Change Password (User spec 148, 149)

