# Copy to .env (git-ignored) and fill in, or export these in the CI runner.
# Names follow docs/e2e-conventions.md §5.

# Actor accounts (shared across suites): <APP>_<ROLE>_PASSWORD
GS_TC_PASSWORD=   # Total Control Client A (Global Settings). Suite Brand: totalControl_automated_qaTeam1@qwertysystem.net; suite Auth: totalControlGlobalSettings_automated_{namaCompany}@qwertysystem.net. Satu password hanya bila kedua akun berbagi password; bila tidak, tim FE menetapkan nama env terpisah.

# Global Settings > Master Reference > Brand: akun per role (password dikelola tim FE)
GS_TC2_PASSWORD=   # totalControlSecond_automated_qaTeam1@qwertysystem.net (Total Control Client A, admin kedua; fixture baru)
GS_RO_PASSWORD=   # readOnly_automated_qaTeam1@qwertysystem.net (Read Only Client A)
GS_READ_PASSWORD=   # readCapability_automated_qaTeam1@qwertysystem.net (System Role: Read saja)
GS_CREATE_PASSWORD=   # createOnly_automated_qaTeam1@qwertysystem.net (System Role: Create dan Read)
GS_UPDATE_PASSWORD=   # updateOnly_automated_qaTeam1@qwertysystem.net (System Role: Update dan Read)
GS_DELETE_PASSWORD=   # deleteOnly_automated_qaTeam1@qwertysystem.net (System Role: Delete dan Read)
GS_NOCAP_PASSWORD=   # noCapability_automated_qaTeam1@qwertysystem.net (tanpa capability)
GS_PRINCIPAL_TC_PASSWORD=   # totalControlPrincipal_automated_qaTeam1@qwertysystem.net (Total Control instance Principal)
GS_DISTRIBUTOR_TC_PASSWORD=   # totalControlDistributor_automated_qaTeam1@qwertysystem.net (Total Control instance Distributor; fixture baru)
GS_CLIENTB_TC_PASSWORD=   # totalControl_automated_qaTeam2@qwertysystem.net (Total Control Client B)
GS_CLIENTC_TC_PASSWORD=   # totalControl_automated_qaTeam3@qwertysystem.net (Total Control Client C)
GS_LIMIT_TC_PASSWORD=   # totalControl_automated_qaTeam4@qwertysystem.net (Total Control Client Limit)
GS_LIMIT_TC2_PASSWORD=   # totalControlSecond_automated_qaTeam4@qwertysystem.net (Client Limit, admin kedua; fixture baru)
FA_ADMIN_PASSWORD=   # famsAdmin_automated_qaTeam1@qwertysystem.net (Admin FAMS Client A; fixture baru)
AC_TC_PASSWORD=   # totalControlAdminConsole_automated_{namaCompany}@qwertysystem.net

# Auth > Account Activation test passwords (must satisfy the password policy)
ACT_PASSWORD=          # valid password, e.g. 8-72 chars with upper, lower, digit, special
ACT_PASSWORD_ALT=      # second valid password, different from ACT_PASSWORD
ACT_PASSWORD_72=       # valid password exactly 72 characters
ACT_PASSWORD_SPECIAL=  # valid password using the special characters ! @ ? &
