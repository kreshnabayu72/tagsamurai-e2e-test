# Copy to .env (git-ignored) and fill in, or export these in the CI runner.
# Names follow docs/e2e-conventions.md §5.

# Actor accounts (shared across suites): <APP>_<ROLE>_PASSWORD
GS_TC_PASSWORD=   # Total Control Client A (Global Settings). Suite Brand: totalControl_automated_qaTeam1@qwertysystem.net; suite Auth: totalControlGlobalSettings_automated_{namaCompany}@qwertysystem.net. Satu password hanya bila kedua akun berbagi password; bila tidak, tim FE menetapkan nama env terpisah.

# Global Settings > Master Reference > Brand: akun per role (password dikelola tim FE)
GS_TC2_PASSWORD=   # totalControlSecond_automated_qaTeam1@qwertysystem.net (Total Control Client A, admin kedua; fixture baru)
GS_RO_PASSWORD=   # readOnly_automated_qaTeam1@qwertysystem.net (Read Only Client A)
GS_READ_PASSWORD=   # readCapability_automated_qaTeam1@qwertysystem.net (System Role: Read saja)
GS_CREATE_PASSWORD=   # createOnly_automated_qaTeam1@qwertysystem.net (System Role: Create dan Read)
GS_UPDATE_PASSWORD=   # updateOnly_automated_qaTeam1@qwertysystem.net (System Role: Update dan Read)
GS_DELETE_PASSWORD=   # deleteOnly_automated_qaTeam1@qwertysystem.net (System Role: Delete dan Read)
GS_NOCAP_PASSWORD=   # noCapability_automated_qaTeam1@qwertysystem.net (tanpa capability)
# Global Settings > File Manager: akun per role (password dikelola tim FE)
GS_FILES_READ_PASSWORD=   # manageFilesRead_automated_{namaCompany}@qwertysystem.net (Manage files: Read; Doni Saputra)
GS_FILES_DELETE_PASSWORD=   # manageFilesDelete_automated_{namaCompany}@qwertysystem.net (Manage files: Delete; Agus Wibowo)
GS_FILES_DELETE_CLONE_PASSWORD=   # akun klon milik spec 008 dengan capability Manage files: Delete (disediakan tim FE)
GS_NOACCESS_PASSWORD=   # noAccessGlobalSettings_automated_{namaCompany}@qwertysystem.net (tanpa akses File Manager; Lina Marlina)
GS_TC_EMPTY_PASSWORD=   # Total Control pada client uji tanpa data (spec 003; disediakan tim FE)
GS_PRINCIPAL_TC_PASSWORD=   # totalControlPrincipal_automated_qaTeam1@qwertysystem.net (Total Control instance Principal)
GS_DISTRIBUTOR_TC_PASSWORD=   # totalControlDistributor_automated_qaTeam1@qwertysystem.net (Total Control instance Distributor; fixture baru)
GS_CLIENTB_TC_PASSWORD=   # totalControl_automated_qaTeam2@qwertysystem.net (Total Control Client B)
GS_CLIENTC_TC_PASSWORD=   # totalControl_automated_qaTeam3@qwertysystem.net (Total Control Client C)
GS_LIMIT_TC_PASSWORD=   # totalControl_automated_qaTeam4@qwertysystem.net (Total Control Client Limit)
GS_LIMIT_TC2_PASSWORD=   # totalControlSecond_automated_qaTeam4@qwertysystem.net (Client Limit, admin kedua; fixture baru)
FA_ADMIN_PASSWORD=   # famsAdmin_automated_qaTeam1@qwertysystem.net (Admin FAMS Client A; fixture baru)
AC_TC_PASSWORD=   # totalControlAdminConsole_automated_{namaCompany}@qwertysystem.net

# Auth > Account Activation test passwords (must satisfy the password policy)
ACT_PASSWORD=          # valid password, e.g. 8-72 chars with upper, lower, digit, special
ACT_PASSWORD_ALT=      # second valid password, different from ACT_PASSWORD
ACT_PASSWORD_72=       # valid password exactly 72 characters
ACT_PASSWORD_SPECIAL=  # valid password using the special characters ! @ ? &

# Auth > Login with Password test passwords
LP_PASSWORD=                # password valid akun uji Login with Password (QaLogin#2026 di TC)
LP_PASSWORD_NEW=            # password baru hasil Reset Password, memenuhi Password Policy (NewPass#2026 di TC)
LP_PASSWORD_WRONG=          # password salah yang valid secara format (SalahPass#1 di TC)
LP_PASSWORD_WRONG_SPECIAL=  # password salah berisi karakter khusus (x'"<>&%$#@! di TC)
LP_PASSWORD_SPACED=         # password dengan spasi di awal dan akhir (" Spasi#2026 " di TC); di-set langsung oleh BE
AC_PRINCIPAL_PP_PASSWORD=   # principalSettingsPrivacyPolicy_automated_{namaCompany}@qwertysystem.net (Principal, Admin Console > Settings > Privacy Policy)

# Auth > MFA test passwords (must satisfy the password policy)
MFA_PASSWORD=               # password valid user uji MFA yang di-seed lewat API
MFA_PASSWORD_NEW=           # password baru hasil Reset Password user uji MFA (spec 037)
# Auth > MFA: akun Total Control per Client (totalControlGlobalSettings_automated_{namaCompany}@qwertysystem.net milik tiap Client); password dikelola tim FE
GS_CLIENTSUSP_TC_PASSWORD=   # Total Control Client uji Suspended (Auth > MFA spec 038)
GS_CLIENTEXP_TC_PASSWORD=   # Total Control Client uji Expired (Auth > MFA spec 038)
GS_PLANSTARTER_TC_PASSWORD=   # Total Control Client plan Starter (Auth > MFA spec 039)
GS_PLANGROWTH_TC_PASSWORD=   # Total Control Client plan Growth (Auth > MFA spec 039)
GS_PLANPRO_TC_PASSWORD=   # Total Control Client plan Professional (Auth > MFA spec 039)
GS_PLANENT_TC_PASSWORD=   # Total Control Client plan Enterprise (Auth > MFA spec 039)

# Auth > Session Management test passwords (must satisfy the password policy)
SES_PASSWORD=               # password valid user uji Session Management yang di-seed lewat API
SES_PASSWORD_NEW=           # password baru hasil Change/Reset Password user uji Session Management
FA_MGL_PASSWORD=           # manageGlobalLicenseFixedAsset_automated_{namaCompany} (dipakai spec Session Management)
AC_PRINCIPAL_PASSWORD=      # principalAdminConsole_automated_{namaCompany} (dipakai spec Session Management)

# Auth > Reset Password test passwords (must satisfy the password policy)
RST_PASSWORD=               # password aktif user uji Reset Password yang di-seed lewat API (QaReset!2026 di TC)
RST_PASSWORD_NEW=           # password baru hasil Reset Password, berbeda dari RST_PASSWORD (QaBaru!2027 di TC)
RST_PASSWORD_ALT=           # password valid kedua untuk Confirm Password berbeda (QaBaru!2028 di TC)
RST_PASSWORD_ALT2=          # password valid ketiga untuk submit tab kedua (QaBaru!2029 di TC)
RST_PASSWORD_REPLAY=        # password valid untuk uji replay token consumed (QaReplay!2028 di TC)
RST_PASSWORD_LOWER=          # RST_PASSWORD_NEW dalam huruf kecil semua (qabaru!2027 di TC-112), untuk uji login case-sensitive
RST_PASSWORD_WRONG=          # password salah yang memenuhi format dan berbeda dari password aktif (SalahSalah!1 di TC-110)

# Auth > Login with OTP
OTP_PASSWORD=               # password valid yang dipasang ke user uji Login with OTP saat seeding aktivasi lewat API, dan dipakai untuk Login with Password di TC-AUTH-OTP-68 dan TC-AUTH-OTP-108
OTP_TOTP_SECRET_IDLE=       # secret TOTP authenticator yang didaftarkan hook before untuk profil IDLE (spec 033/034)
OTP_TOTP_SECRET_NEWDEV=     # secret TOTP authenticator yang didaftarkan hook before untuk profil NEWDEV (spec 033/034)

# Global Settings > User: akun aktor dan password user dinamis (password dikelola tim FE)
GS_DEFAULT_PASSWORD=        # defaultUserGlobalSettings_automated_{namaCompany}@qwertysystem.net (Default User, Total Control, MFA Enrolled); dipakai juga untuk Default User client baru (spec 004, 078)
GS_FULLCRUD_PASSWORD=       # manageUserFullCrud_automated_{namaCompany}@qwertysystem.net (Manage user and role, Full CRUD)
GS_BASIC_PASSWORD=          # basicGlobalSettings_automated_{namaCompany}@qwertysystem.net (Basic, Access GS tanpa tier dan role)
GS_NOFAMS_TC_PASSWORD=      # Total Control Client tanpa subscription Fixed Asset (User spec 065, TC-385); disediakan tim FE
GS_NOSUPPLY_TC_PASSWORD=    # Total Control Client tanpa subscription Supply Asset (User spec 155, TC-980); disediakan tim FE
AC_STAFF_PASSWORD=          # staff Principal Admin Console (Rizal Akbar) untuk aksi Assign Role (User spec 147); disediakan tim FE
USER_PASSWORD=              # password valid (memenuhi password policy) yang dipasang ke user dinamis milik spec Global Settings > User lewat seeding API
USER_PASSWORD_NEW=          # password baru valid untuk event Change Password user dinamis (User spec 102-107)
USER_PASSWORD_WRONG=        # password salah yang valid secara format, dipakai untuk Login Failed dan lock Change Password (User spec 148, 149)

# Global Settings > All Tags: akun aktor tambahan (password dikelola tim FE; tanpa nilai)
GS_TAG_UPDATE_PASSWORD=   # Manage TAG (Update) Client A (All Tags spec 006, 008, 013, 018, 042); disediakan tim FE
GS_TAG_READ_PASSWORD=   # Manage TAG (Read) Client A (All Tags spec 006, 014); disediakan tim FE
GS_FAMS_ASSETTAG_READ_PASSWORD=   # Manage asset & TAG di FAMS: Read (All Tags spec 009, 014); disediakan tim FE
GS_FAMS_ASSETTAG_UPDATE_PASSWORD=   # Manage asset & TAG di FAMS: Update (All Tags spec 009); disediakan tim FE
GS_TC_ALLPAIRED_PASSWORD=   # Total Control Client uji semua tag Paired (All Tags spec 004); disediakan tim FE
GS_TC_FREE_PASSWORD=   # Total Control Client uji plan Free (All Tags spec 010, 011); disediakan tim FE
GS_TC_DOWN_PASSWORD=   # Total Control Client uji hasil downgrade ke Free (All Tags spec 010); disediakan tim FE
GS_TC_NOBYO_PASSWORD=   # Total Control Client uji tanpa opsi mandiri/BYO (All Tags spec 019, 023, 029, 030, 036); disediakan tim FE
GS_TC_QUOTA_PASSWORD=   # Total Control Client uji kuota (Client Quota) (All Tags spec 017, 018, 023, 034); disediakan tim FE
GS_TC_OVER_PASSWORD=   # Total Control Client uji kuota terlampaui (Client Over) (All Tags spec 017); disediakan tim FE
GS_TC_SUSP_PASSWORD=   # Total Control Client uji Suspended/Expired (All Tags spec 012); disediakan tim FE
GS_TC_AUDIT_PASSWORD=   # Total Control Client Audit (All Tags spec 040-045, 088, 090, 091, 095); disediakan tim FE
GS_TC_LOG_PASSWORD=   # Total Control Client Log (All Tags spec 086, 092-096); disediakan tim FE
GS_TC_LARGE_PASSWORD=   # Total Control Client Large 5.200 tag (All Tags spec 080); disediakan tim FE
GS_TC_PROFESSIONAL_PASSWORD=   # Total Control Client uji plan Professional (All Tags spec 010); disediakan tim FE
GS_TC_ENTERPRISE_PASSWORD=   # Total Control Client uji plan Enterprise (All Tags spec 010); disediakan tim FE

# Fixed Asset > Settings > Categories: akun per role (nama usulan generate spec; password dikelola tim FE)
FA_TC_PASSWORD=   # Total Control (Pre-setup #1; dipakai di seluruh client uji Categories: CatMain, CatFresh, CatThree, CatExcess, CatPostT0, CatPreT0, CatCode, dll.)
FA_RO_PASSWORD=   # Read Only (#2)
FA_CAPREAD_PASSWORD=   # Capability Read (#3)
FA_CO_PASSWORD=   # Create Only (#4)
FA_UO_PASSWORD=   # Update Only (#5)
FA_DO_PASSWORD=   # Delete Only (#6)
FA_CUD_PASSWORD=   # Create+Update+Delete (#7)
FA_GMNOCAP_PASSWORD=   # Group Manager tanpa capability (#8)
FA_GMCAP_PASSWORD=   # Group Manager dengan capability (Read)
FA_GMCRUD_PASSWORD=   # Group Manager CRUD (#9)
FA_NOROLE_PASSWORD=   # User tanpa role (#10)
FA_FS_PASSWORD=   # akun Fixed Asset Settings (spec Categories gerbang kolom)
FA_AV_PASSWORD=   # akun hak Asset Value
FA_PGA_PASSWORD=   # Purchase Group A (#53)
FA_ACCGL_PASSWORD=   # Accounting Global (#52)
FA_NOSENS_PASSWORD=   # tanpa hak nilai sensitif (#54)
FA_DU_PASSWORD=   # Default User (#57)
FA_ATPREAD_PASSWORD=   # ATP Read (#12)
FA_APPROVER_PASSWORD=   # Approver Koreksi (#43)
